{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "InsPhoto Console",
  "version": "../package.json",
  "identifier": "com.brad.insphoto.console",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "console",
        "title": "InsPhoto Console",
        "url": "index.html",
        "width": 1366,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 680,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Brad Yee",
    "shortDescription": "InsPhoto event console",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
